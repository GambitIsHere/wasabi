# Wasabi self-host — copy to .env (gitignored) and fill in. NEVER commit the real values.
WASABI_DOMAIN=wasabi.example.com          # subdomain you point at this host
LETSENCRYPT_EMAIL=ops@sanjow.com
GENERIC_TIMEZONE=Europe/London

# Admin-UI basic-auth (the /decide + /capture API stay public for storefronts).
# Generate the hash:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOURPASS'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=

# Read-only Metabase key for the live P&L verdict (the dashboard reads, never writes).
# Leave blank to run without live results (the UI degrades gracefully).
METABASE_URL=https://metabase.paynova.app
METABASE_API_KEY=
