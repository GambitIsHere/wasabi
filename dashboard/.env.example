# Wasabi dashboard env vars. Copy to .env.local for local dev; set in the
# Vercel project for deploys.

# ─── REQUIRED ──────────────────────────────────────────────────────────────

# Neon Postgres (Vercel's managed offering injects DATABASE_URL automatically;
# POSTGRES_URL is read as a fallback). The experiment store lives here — the
# dashboard will fail to start if neither is set.
DATABASE_URL=
# POSTGRES_URL=

# Auth.js v5 (next-auth@beta) — Google SSO + email/password, both restricted
# per-org to the signing-in org's organization.verified_domain (Batch D-a).
# AUTH_SECRET: random 32-byte string used to encrypt session JWTs. Generate
#   with: `openssl rand -base64 32`. Must be stable across deployments — change
#   it and every active session is invalidated.
AUTH_SECRET=
# AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: from Google Cloud Console
#   → APIs & Services → Credentials → OAuth Client ID. The Client Secret is
#   sensitive — set it in Vercel env only, never commit it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_ALLOWED_EMAIL_DOMAIN: FALLBACK ONLY, used solely when the resolved
#   org's organization.verified_domain column is unset. The org record is now
#   the source of truth for domain restriction (both Google sign-in and
#   password registration) — see auth.config.ts, lib/domain-restriction.ts.
#   Every org still needs SOME domain configured somewhere; with neither this
#   nor verified_domain set, sign-in/registration fails closed for that org.
AUTH_ALLOWED_EMAIL_DOMAIN=sanjow.com

# RESEND_API_KEY: NOT YET IMPLEMENTED — see lib/email-verification.ts. Setting
#   this only flips isEmailProviderConfigured() to true; there is no actual
#   send call wired up in this batch, so a self-registered account's ONLY
#   real path out of "pending" today is an org owner/admin approving them at
#   /admin/members. Leave unset until a real provider integration lands —
#   setting it prematurely would make the "pending" UI copy claim an email
#   was sent that never will be.
# RESEND_API_KEY=

# ─── OPTIONAL ──────────────────────────────────────────────────────────────

# Metabase connection for live experiment results. When METABASE_API_KEY is
# unset the results panel degrades gracefully to a "Connect Metabase to see
# live results" empty-state (never an error).
# METABASE_URL: base URL of the Metabase instance that fronts the global-api
#   Postgres ("MAIN DB - Production"). No trailing slash.
# METABASE_API_KEY: a Metabase API key with read access to that database.
METABASE_URL=https://metabase.paynova.app
METABASE_API_KEY=

# YouTrack connection for the test backlog page. When YOUTRACK_TOKEN is unset
# the backlog page shows a "YouTrack not connected" empty-state.
# YOUTRACK_HOST: the YouTrack instance (e.g. sanjow.youtrack.cloud).
# YOUTRACK_TOKEN: a read-only YouTrack API token.
# YOUTRACK_BACKLOG_QUERY: optional override of the default backlog query —
#   set to `tag: experiment` once that tag is backfilled across tickets, or
#   leave unset for the keyword heuristic.
YOUTRACK_HOST=
YOUTRACK_TOKEN=
# YOUTRACK_BACKLOG_QUERY=tag: experiment

# WASABI_INGEST_KEY: shared secret for POST /api/capture, the public,
#   unauthenticated endpoint storefronts call to log events. When SET, a
#   request must send it back as the `x-wasabi-key` header or gets 401. When
#   UNSET (default today), the endpoint keeps accepting every request — same
#   behaviour as before this existed — but logs one console warning per warm
#   instance so the gap stays visible. Independent of this, /api/capture
#   always rate-limits at ~60 events/minute/IP. Generate a value with:
#   `openssl rand -hex 32`.
WASABI_INGEST_KEY=
