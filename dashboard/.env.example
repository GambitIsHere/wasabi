# Metabase connection for live experiment results.
# When METABASE_API_KEY is unset the results route degrades gracefully to a
# "Connect Metabase to see live results" empty-state (never an error).

# Base URL of the Metabase instance that fronts the global-api Postgres
# ("MAIN DB - Production"). No trailing slash.
METABASE_URL=https://metabase.paynova.app

# A Metabase API key with read access to "MAIN DB - Production".
# Leave unset locally to exercise the graceful empty-state.
METABASE_API_KEY=
