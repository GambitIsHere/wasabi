{
  "name": "wasabi-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Wasabi — Sanjow's in-house experimentation engine dashboard",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "reseed": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-hook-register.mjs scripts/reseed.ts",
