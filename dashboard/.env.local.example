# Local dev against docker-compose.dev.yml (Postgres + Neon proxy).
# Copy to .env.local, then add a secret:
#   cp .env.local.example .env.local
#   echo "AUTH_SECRET=$(openssl rand -base64 32)" >> .env.local
# See LOCAL-DEV.md for the full walkthrough. .env.local is gitignored.

# ─── Local Postgres (via the proxy) ─────────────────────────────────────────
# Routes @neondatabase/serverless at the local Neon-protocol proxy instead of
# Neon cloud. USE_LOCAL_PG turns the branch on; NEON_LOCAL_PROXY is the proxy URL.
DATABASE_URL=postgresql://wasabi:wasabi@localhost:5432/wasabi
USE_LOCAL_PG=1
NEON_LOCAL_PROXY=http://localhost:4444/sql

# ─── Auth (dev bypass) ──────────────────────────────────────────────────────
# Skip Google SSO locally so you can reach the admin without a Workspace login.
# ⚠️  DEV ONLY. This disables the ENTIRE auth gate. It ships commented out on
#     purpose — uncomment it only for local dev against docker-compose.dev.yml.
#     middleware.ts throws at boot if it is ever "1" while VERCEL is set or
#     NODE_ENV=production, so it cannot leak into a deployed environment.
# WASABI_DEV_NO_AUTH=1
AUTH_ALLOWED_EMAIL_DOMAIN=sanjow.com
# Auth.js needs a secret even when the gate is bypassed. Generate one:
#   openssl rand -base64 32
AUTH_SECRET=

# ─── Optional: live Metabase results ────────────────────────────────────────
# Leave blank and the results panel shows a graceful "Connect Metabase" state.
# METABASE_URL=https://metabase.paynova.app
# METABASE_API_KEY=
